# Sao chép thành `.env.local`. Cùng Supabase project với app user — chỉ publishable trong browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Public URL của **ứng dụng admin** (khác app user).
# Dev: có thể bỏ trống → dùng window.location.origin.
# Production (Vercel / hosting admin): bắt buộc đúng subdomain admin.
VITE_APP_URL=https://admin.ngaylanhthangtot.vn

# ── Supabase Dashboard → Authentication ───────────────────────────────────
# Providers → Email: bật "Email" và (tuỳ chọn) "Confirm email".
# Đăng nhập admin bằng mật khẩu: tạo user trong Authentication → Users (hoặc SQL),
# gán mật khẩu; email phải có trong ADMIN_EMAILS.
#
# Redirect URLs (Additional): thêm callback admin, ví dụ:
#   https://admin.ngaylanhthangtot.vn/auth/callback
#   http://localhost:5173/auth/callback
#
# ── Edge Functions (deploy từ repo Ngay-lanh-thang-tot — KHÔNG admin repo) ─
#   supabase secrets set ADMIN_EMAILS=you@corp.com,other@corp.com
#   supabase secrets set ALLOWED_ORIGIN=https://ngaylanhthangtot.vn,https://admin.ngaylanhthangtot.vn
#   supabase functions deploy admin-dashboard-stats admin-site-banner admin-users admin-user-entitlements admin-orders admin-referrals admin-coupons
#
# ── Chỉ deploy từ repo admin này ─────────────────────────────────────────
#   supabase functions deploy admin-config admin-user-actions
